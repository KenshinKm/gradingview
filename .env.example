# ============================================================
# GradingView environment variables
# Copy to `.env.local` for local development.
# NEVER commit real credentials.
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BILLING_MODE controls entitlement behavior.
#   dev  -> free credit + generous local allowance, no Stripe required (ONLY works when NODE_ENV !== production)
#   live -> real Stripe entitlement checks (required in production)
BILLING_MODE=dev

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Name of the Storage bucket that holds uploaded documents.
SUPABASE_STORAGE_BUCKET=gradingview-uploads

# ---- LLM provider (server-side only) ----
# LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
# Vision-capable model used to read rubric/assignment images.
LLM_VISION_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional: override base URL for OpenAI-compatible gateways.
OPENAI_BASE_URL=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STUDENT_PRICE_ID=price_xxx
STRIPE_STUDENT_PLUS_PRICE_ID=price_xxx

# ---- Limits (optional overrides) ----
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=40
