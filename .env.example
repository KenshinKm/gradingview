# ============================================================
# GradingView environment variables
# Copy to `.env.local` for local development.
# NEVER commit real credentials.
# ============================================================

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BILLING_MODE controls entitlement behavior.
#   dev  -> free credit + generous local allowance, no Stripe required (ONLY works when NODE_ENV !== production)
#   live -> real Stripe entitlement checks (required in production)
BILLING_MODE=dev

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Name of the Storage bucket that holds uploaded documents.
SUPABASE_STORAGE_BUCKET=gradingview-uploads

# ---- LLM provider (server-side only) ----
# LLM_PROVIDER: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Vision-capable model used to read rubric/assignment images.
LLM_VISION_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional: override base URL for OpenAI-compatible gateways.
OPENAI_BASE_URL=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STUDENT_PRICE_ID=price_xxx
STRIPE_STUDENT_PLUS_PRICE_ID=price_xxx

# ---- Limits (optional overrides) ----
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=40

# ---- Abuse limits (optional) ----
# Successful free grades allowed per client network (hashed IP) per 7 days.
FREE_GRADE_IP_LIMIT=9
# Salt for hashing client IPs before storing them. Set a random value in prod.
IP_HASH_SALT=change-me-in-production

# ---- TikTok ads (optional; leave unset in dev so local traffic never hits the real pixel) ----
# Pixel id from TikTok Events Manager. Public (it appears in page source).
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Events API access token (Events Manager > Web Events > Settings > Events API). Secret, server-only.
TIKTOK_EVENTS_API_TOKEN=
# Optional: while testing, paste the Test Events code so events show in the Test Events tab, not production data.
TIKTOK_TEST_EVENT_CODE=
